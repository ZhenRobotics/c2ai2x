{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2AI2X Core v1 Asynchronous Terminal Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "version", "message_id", "trace_id", "in_reply_to_request_id", "kind", "payload"],
  "properties": {
    "standard": {"const": "c2ai2x-core"},
    "version": {"const": "v1"},
    "message_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "in_reply_to_request_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string"},
    "payload": {}
  },
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "completed"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_id", "result"],
          "properties": {
            "workflow_id": {"type": "string", "minLength": 1},
            "result": {"type": "object"}
          }
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "failed"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_id", "error"],
          "properties": {
            "workflow_id": {"type": "string", "minLength": 1},
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "retryable": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "cancelled"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_id", "reason"],
          "properties": {
            "workflow_id": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
